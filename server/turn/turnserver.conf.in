# MieMie Multiplayer Lobby / 咩咩联机大厅
realm=@HOST@
listening-ip=@LOCAL_IP@
relay-ip=@LOCAL_IP@
external-ip=@PUBLIC_IP@/@LOCAL_IP@
listening-port=3478
min-port=49160
max-port=49223
use-auth-secret
static-auth-secret=@SECRET@
no-tls
no-dtls
no-tcp-relay
no-multicast-peers
no-cli
no-rfc5780
no-software-attribute
fingerprint
user-quota=8
total-quota=32
max-bps=131072
bps-capacity=4194304
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
log-file=stdout
simple-log
pidfile=/run/miemie-multiplayer-lobby-turn/turnserver.pid
userdb=/run/miemie-multiplayer-lobby-turn/turndb
