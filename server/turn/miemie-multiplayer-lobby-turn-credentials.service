[Unit]
Description=MieMie Multiplayer Lobby TURN credential service
Requires=miemie-multiplayer-lobby-turn.service
After=miemie-multiplayer-lobby-turn.service

[Service]
Type=simple
DynamicUser=true
WorkingDirectory=/opt/MieMie-Multiplayer-Lobby/current/server/turn
EnvironmentFile=/etc/miemie-multiplayer-lobby/credentials.env
LoadCredential=turn-secret:/etc/miemie-multiplayer-lobby/turn-secret
ExecStart=/opt/miemie-node/bin/node /opt/MieMie-Multiplayer-Lobby/current/server/turn/credentials.mjs
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=
MemoryMax=96M
TasksMax=32
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
